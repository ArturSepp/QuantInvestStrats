{
  "schema_version": 1,
  "description": "Eighteen fixed-sample synthetic exhibits: focused gallery previews, model-layer attribution and one teaching figure per handbook chapter, with common typography and recorded calculation conventions.",
  "dependencies": [
    "numpy",
    "pandas",
    "scipy",
    "matplotlib",
    "seaborn",
    "statsmodels",
    "numba",
    "Pillow",
    "qis"
  ],
  "producers": {
    "gallery": {
      "module": "tools.docs_analytics.gallery",
      "callable": "produce",
      "fixture": "qis.datasets.generate_synthetic_universe",
      "parameters": {
        "start": "2018-01-02",
        "end": "2025-12-31",
        "seed": 20260725,
        "apply_quirks": true,
        "assets": [
          "SEQ_US",
          "SBD_TSY",
          "SBD_IG",
          "SCM_GLD"
        ],
        "weights": {
          "Balanced": [
            0.5,
            0.3,
            0.1,
            0.1
          ],
          "Defensive": [
            0.2,
            0.5,
            0.2,
            0.1
          ],
          "Growth": [
            0.7,
            0.1,
            0.1,
            0.1
          ]
        },
        "rebalancing_freq": "QE",
        "rebalancing_costs": 0.001,
        "weight_implementation_lag": 0,
        "reporting_frequency": "monthly"
      },
      "conventions": {
        "data": "Synthetic, fixed sample; not observed market performance",
        "returns": "Simple returns for backtesting; panel statistics use the recorded reporting preset",
        "reporting_grid": "ME",
        "native_grid": "B",
        "regime_grid": "QE",
        "rebalance_timing": "Units held between quarter-end rebalancings; close-t weights apply over [t,t+1]",
        "rate_basis": "No risk-free-rate data; non-excess statistics",
        "cost_basis": "Portfolio NAVs net of 10 bp per unit traded; synthetic benchmark has no costs"
      },
      "tables": [
        "prices",
        "benchmark",
        "portfolio_navs",
        "performance",
        "balanced_weights",
        "balanced_turnover",
        "balanced_costs"
      ],
      "checks": [
        "positive_complete_prices",
        "finite_positive_navs",
        "weights_sum_to_one",
        "zero_cost_nav_reconciles_units"
      ]
    },
    "model_layer": {
      "module": "tools.docs_analytics.model_layer",
      "callable": "produce",
      "fixture": "examples.portfolios.model_layer_attribution_simulated",
      "parameters": {
        "seed": 169,
        "feature_seed": 170,
        "start": "2005-12-31",
        "end": "2025-12-31",
        "freq": "ME",
        "hac_lags": 3,
        "confidence_level": 0.95
      },
      "conventions": {
        "data": "Dedicated seeded model-layer teaching fixture, preserved unchanged",
        "returns": "Monthly additive log returns; annualised means multiply by 12",
        "estimation": "Full-sample OLS, descriptive attribution",
        "uncertainty": "95% Bartlett HAC(3) intervals",
        "cost_basis": "Gross and net model NAVs; 0.15% annual proportional log-return cost drag",
        "rate_basis": "Raw benchmark returns; no risk-free-rate subtraction",
        "feature_basis": "Full factorial two-feature experiment; Shapley averages"
      },
      "tables": [
        "navs",
        "regressions",
        "periodic_returns",
        "components",
        "annualised_components",
        "feature_summary",
        "feature_identity_errors",
        "feature_scenarios",
        "cumulative_alpha_lines"
      ],
      "checks": [
        "ols_linearity_and_excess_basis",
        "feature_design",
        "shapley_identity",
        "displayed_bridge_matches_components"
      ]
    },
    "handbook": {
      "module": "tools.docs_analytics.handbook",
      "callable": "produce",
      "fixture": "qis.datasets.generate_synthetic_universe",
      "parameters": {
        "start": "2005-01-03",
        "end": "2025-12-31",
        "seed": 20260725,
        "ewm_spans": [
          12,
          36
        ],
        "smoothing_theta": 0.6,
        "acf_lags": 8,
        "regime_assets": [
          "SEQ_US",
          "SBD_TSY",
          "SCM_GLD",
          "SAL_HF"
        ],
        "bootstrap_n": 250,
        "bootstrap_paths": 400,
        "bootstrap_block": 20,
        "bootstrap_seed": 7,
        "man_fee": 0.02,
        "perf_fee": 0.2,
        "benchmark": "SEQ_US",
        "regression_asset": "SBD_HY",
        "allocation": {
          "SEQ_US": 0.5,
          "SBD_TSY": 0.3,
          "SBD_IG": 0.1,
          "SCM_GLD": 0.1
        },
        "risk_start": "2021-01-01",
        "vol_span": 33,
        "vol_target": 0.1,
        "vol_regimes": [
          [
            "2008-09-01",
            "2009-06-30",
            2.5
          ],
          [
            "2020-03-01",
            "2020-06-30",
            3.0
          ],
          [
            "2013-01-01",
            "2016-12-31",
            0.6
          ]
        ]
      },
      "conventions": {
        "data": "Synthetic, fixed sample without quirks; not observed market performance",
        "returns": "Stated per exhibit: monthly log or simple, quarterly regime grid, daily targeting",
        "annualisation": "AN = 12 monthly, 4 quarterly, 252 daily as set by qis frequency maps",
        "rate_basis": "Zero cash rate; no risk-free-rate data",
        "cost_basis": "Gross returns except the fee exhibit: 2% management, 20% performance fee",
        "teaching_constructions": "Volatility regimes scale SEQ_US returns in the targeting exhibit; the truncating bootstrap draw comes from the example",
        "checks": "Each exhibit has an independent closed-form or numpy check of its plotted values"
      },
      "tables": [
        "ewm_kernels",
        "pca_eigenvalues",
        "smoothed_acf",
        "sharpe_wedge",
        "drawdown_path",
        "regime_sharpe",
        "bootstrap_frequencies",
        "fee_navs",
        "benchmark_regression",
        "risk_contributions",
        "vol_targeting"
      ],
      "checks": [
        "ewm_kernels",
        "pca_eigenvalues",
        "smoothed_acf",
        "sharpe_wedge",
        "drawdown_path",
        "regime_sharpe",
        "bootstrap_frequencies",
        "fee_navs",
        "benchmark_regression",
        "risk_contributions",
        "vol_targeting"
      ]
    }
